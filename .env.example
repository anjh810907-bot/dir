# ========================================================
# 따뜻한 하루 일기 & AI 응원 환경 변수 설정 (.env.example)
# ========================================================

# 1. 서버 환경 변수 (Express, Vercel Serverless Functions)
# Google AI Studio 또는 Vercel Project Settings > Environment Variables에 등록하세요.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 2. 클라이언트 환경 변수 (Vite / Vercel SPA 정적 배포 지원용)
# 만약 정적 클라이언트 배포 환경에서 실행할 경우 아래 변수를 설정할 수 있습니다.
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 앱 호스팅 주소 (AI Studio 자동 주입)
APP_URL="http://localhost:3000"

